{
    "name": "juanmafx/formulario-dorado",
    "description": "Secure contact form with an encrypted submission store and a TOTP-protected admin area.",
    "type": "project",
    "license": "proprietary",
    "version": "2.0.0",
    "require": {
        "php": ">=8.4.1 <8.6",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-session": "*",
        "ext-sodium": "*",
        "phpmailer/phpmailer": "^7.2",
        "psr/clock": "^1.0",
        "spomky-labs/otphp": "^11.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": { "psr-4": { "FormularioDorado\\": "backend/src/" } },
    "autoload-dev": { "psr-4": { "FormularioDorado\\Tests\\": "backend/tests/" } },
    "config": {
        "allow-plugins": false,
        "platform": { "php": "8.4.28" },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M"
    }
}
